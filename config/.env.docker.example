# Copy this file to config/.env before starting the stack.
# Generate every replace-me value independently. Never commit config/.env.

NODE_ENV=production
APP_TIMEZONE=America/Los_Angeles
N8N_IMAGE=n8nio/n8n:latest
POSTGRES_IMAGE=pgvector/pgvector:pg17
REDIS_IMAGE=redis:7.4-alpine
N8N_PORT=5678
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://localhost:5678/

N8N_ENCRYPTION_KEY=replace-me-with-32-plus-random-characters
N8N_USER_MANAGEMENT_JWT_SECRET=replace-me-with-a-different-random-secret
POSTGRES_DATABASE=shopify_automation
POSTGRES_USER=automation
POSTGRES_PASSWORD=replace-me-with-a-random-database-password
REDIS_PASSWORD=replace-me-with-a-random-redis-password

EXECUTIONS_TIMEOUT=300
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
N8N_WORKER_CONCURRENCY=5

SHOPIFY_STORE_DOMAIN=c6w6yz-rz.myshopify.com
SHOPIFY_STORE_NAME=My Store 4
SHOPIFY_API_VERSION=2026-07
CJ_ACCOUNT_ID=CJ5748386
CJ_API_ENABLED=false

OPENAI_ORCHESTRATOR_MODEL=replace-with-approved-openai-model
OPENAI_SUPERVISOR_MODEL=replace-with-approved-openai-model
AI_SPECIALIST_PRIMARY_PROVIDER=anthropic
AI_SPECIALIST_PRIMARY_MODEL=replace-with-approved-claude-model
AI_FALLBACK_PROVIDER=replace-with-approved-fallback
AI_FALLBACK_MODEL=replace-with-approved-fallback-model
AI_MAX_RETRIES=2
AI_REALTIME_TIMEOUT_MS=30000
AI_REALTIME_MAX_TOKENS=1200

AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
AGENTMAIL_INBOX_ID=
GOOGLE_SHEETS_WORKBOOK_ID=

AUTO_PUBLISH_PRODUCTS=false
AUTO_SUBMIT_SUPPLIER_ORDERS=false
AUTO_SEND_SUPPORT_MESSAGES=false
AUTO_PROCESS_REFUNDS=false
AUTO_CREATE_DISCOUNTS=false
AUTO_LAUNCH_CAMPAIGNS=false
SYSTEM_KILL_SWITCH=true
