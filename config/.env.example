# Runtime
NODE_ENV=production
APP_TIMEZONE=America/Los_Angeles
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
N8N_USER_MANAGEMENT_JWT_SECRET=replace-with-a-different-long-random-secret
WEBHOOK_URL=https://your-n8n-host.example.com/
EXECUTIONS_TIMEOUT=300
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# Queue mode / durable workers
EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=replace-me
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=replace-me

# PostgreSQL
POSTGRES_HOST=replace-me
POSTGRES_PORT=5432
POSTGRES_DATABASE=shopify_automation
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_SSL=true

# Shopify — store credentials are configured in n8n Credentials, not committed
SHOPIFY_STORE_DOMAIN=c6w6yz-rz.myshopify.com
SHOPIFY_API_VERSION=2026-07

# Google Sheets
GOOGLE_SHEETS_WORKBOOK_ID=replace-after-workbook-creation

# AI executive, specialist, and review routing
# Store live values only in Render/n8n secrets; never commit them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_ORCHESTRATOR_MODEL=replace-with-approved-openai-model
OPENAI_SUPERVISOR_MODEL=replace-with-approved-openai-model
AI_SPECIALIST_PRIMARY_PROVIDER=anthropic
AI_SPECIALIST_PRIMARY_MODEL=replace-with-approved-claude-model
AI_FALLBACK_PROVIDER=replace-with-approved-fallback
AI_FALLBACK_MODEL=replace-with-approved-fallback-model
AI_MAX_RETRIES=2
AI_REALTIME_TIMEOUT_MS=30000
AI_REALTIME_MAX_TOKENS=1200

# Safety gates
AUTO_PUBLISH_PRODUCTS=false
AUTO_SUBMIT_SUPPLIER_ORDERS=false
AUTO_SEND_SUPPORT_MESSAGES=false
AUTO_PROCESS_REFUNDS=false
AUTO_CREATE_DISCOUNTS=false
AUTO_LAUNCH_CAMPAIGNS=false
MIN_GROSS_MARGIN_PCT=55
MIN_CONTRIBUTION_PROFIT_USD=8
MAX_AUTOMATIC_PRICE_CHANGE_PCT=0

# CJdropshipping — use n8n encrypted credentials; never put live keys here
CJ_ACCOUNT_ID=CJ5748386
CJ_API_ENABLED=false
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
AGENTMAIL_INBOX_ID=

# Observability and rollout
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=shopify-automation-os
SYSTEM_KILL_SWITCH=true
