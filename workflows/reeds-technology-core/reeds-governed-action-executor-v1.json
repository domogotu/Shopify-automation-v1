    },
    {
      "parameters": {
        "content": "INPUT CONTRACT:\n{ correlation_id, event_id, action_id, tool_id, description, parameters,\n  credential_ref, destination, estimated_cost, records_affected,\n  reversible, verification_method, rollback_method, requesting_agent }\n\nChains Steps 8-9-10-11-12 in one call:\nPolicy Gate + Approval -> Execute (only gmail.* and sheets.* wired so far) -> Verify -> Governed Memory Write.\nUnregistered tool_id => stops and reports, does not execute blindly.",
        "height": 260,
        "width": 460
      },
      "id": "n1",
      "name": "Contract Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1400,
        -40
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_POLICY_GATE_WORKFLOW_ID",
          "cachedResultName": "Reeds - Policy Gate and Approval v1"
        },
        "options": {}
      },
      "id": "ex1",
      "name": "Policy Gate and Approval",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        -1140,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.approved }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "approved"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "sw1",
      "name": "Approved?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        -880,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1",
              "name": "status",
              "value": "denied_or_expired",
              "type": "string"
            },
            {
              "id": "d2",
              "name": "reason",
              "value": "={{ $json.reason }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "set_denied",
