    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "tool_executions",
        "columns": "correlation_id,action_hash,tool_id,parameters,credential_ref,status,provider_receipt,executed_at",
        "additionalFields": {}
      },
      "id": "pg1",
      "name": "Log Tool Execution",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -140,
        220
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_EXISTING_POSTGRES_CREDENTIAL",
          "name": "Reeds Postgres (Render)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Called by Any Action Workflow').first().json;\nconst receiptPackage = $('Package Tool Execution Receipt').first().json;\nconst execResult = receiptPackage.provider_receipt || {};\nconst verified = !!(execResult.id || execResult.messageId || execResult.updatedRange || execResult.threadId);\nreturn {\n  tool_execution_id: $json.tool_execution_id,\n  correlation_id: original.correlation_id,\n  result: verified ? 'verified' : 'uncertain',\n  method: original.verification_method || 'provider_response_inspection',\n  evidence: execResult\n};\n"
      },
      "id": "code_verify",
      "name": "Independent Result Verification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        220
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "verification_results",
        "columns": "tool_execution_id,correlation_id,result,method,evidence",
        "additionalFields": {}
      },
      "id": "pg2",
      "name": "Log Verification Result",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        340,
        220
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_EXISTING_POSTGRES_CREDENTIAL",
          "name": "Reeds Postgres (Render)"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "memories",
        "columns": "memory_type,owner_id,organization_id,fact_or_claim,source_id,confidence,sensitivity,verification_status,created_by_actor,correlation_id",
        "additionalFields": {}
      },
      "id": "pg3",
      "name": "Governed Memory Write",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        580,
        220
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_EXISTING_POSTGRES_CREDENTIAL",
          "name": "Reeds Postgres (Render)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Called by Any Action Workflow').first().json;\nreturn { ...original, status: 'success', provider_receipt: $json, executed_at: new Date().toISOString() };\n"
      },
      "id": "code-package-tool-receipt",
      "name": "Package Tool Execution Receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        220
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Called by Any Action Workflow').first().json;\nconst verification = $('Independent Result Verification').first().json;\nreturn {\n  memory_type: 'tool_execution',\n  owner_id: original.owner_id || 'dominique_root_owner',\n  organization_id: original.organization_id || 'reeds_solutions_llc',\n  project_id: original.project_id || 'service_intake',\n  fact_or_claim: `Tool ${original.tool_id} completed with verification result ${verification.result} for correlation ${original.correlation_id}.`,\n  source_id: verification.tool_execution_id || original.action_hash || original.action_id,\n  confidence: verification.result === 'verified' ? 0.9 : 0.5,\n  sensitivity: original.sensitivity || 'business_confidential',\n  verification_status: verification.result,\n  created_by_actor: original.requesting_agent || 'governed_action_executor',\n  correlation_id: original.correlation_id\n};\n"
      },
      "id": "code-prepare-governed-memory",
      "name": "Prepare Governed Memory Write",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        220
      ]
    }
  ],
