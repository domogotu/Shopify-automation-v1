              "type": "string"
            },
            {
              "id": "e5",
              "name": "authenticated",
              "value": "={{ $json.authenticated }}",
              "type": "boolean"
            }
          ]
        }
      },
      "id": "set1",
      "name": "Execution Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        160,
        320
      ]
    }
  ],
